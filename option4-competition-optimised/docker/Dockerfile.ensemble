# ── Ensemble model container (XGBoost + RandomForest + GradientBoosting) ─────
# Versions MUST match the training environment (Mac):
#   scikit-learn 1.7.0   (model pickled with this version)
#   xgboost      3.2.0   (Booster serialized with this version)

FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    flask==3.0.3 \
    gunicorn==21.2.0 \
    scikit-learn==1.7.0 \
    xgboost==3.2.0 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    boto3==1.34.0

WORKDIR /opt/program
COPY serve.py /opt/program/serve.py

EXPOSE 8080
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["gunicorn", "--bind", "0.0.0.0:8080", "--timeout", "60", "--workers", "1", "serve:app"]
