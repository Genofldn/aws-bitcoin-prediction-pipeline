# ── Time-series container (Prophet + ARIMA/statsmodels) ──────────────────────
# Prophet has no official AWS DLC — custom image required.

FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    flask==3.0.3 \
    gunicorn==21.2.0 \
    prophet==1.1.5 \
    statsmodels==0.14.2 \
    scikit-learn==1.4.2 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    boto3==1.34.0

WORKDIR /opt/program
COPY serve.py /opt/program/serve.py

EXPOSE 8080
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["gunicorn", "--bind", "0.0.0.0:8080", "--timeout", "120", "--workers", "1", "serve:app"]
